  "env": {
    "obs_fields": [
      {
        "field": "AltFt"
      },
      {
        "field": "CasKts"
      },
      {
        "field": "ActiveRouteWaypointDistanceNm",
        "kwargs": {
          "high": 60
        }
      },
      {
        "field": "ActiveRouteWaypointTrackErrorDeg"
      },
      {
        "field": "QueryRegionInside",
        "kwargs": {
          "query_name": "STORM_1"
        }
      },
      {
        "field": "QueryRegionInside",
        "kwargs": {
          "query_name": "STORM_2"
        }
      },
      {
        "field": "ClearanceTimeLeftS",
        "kwargs": {
          "target": "active_route_waypoint_hdg_delta_deg"
        }
      }
    ],
    "intruder_obs_fields": [
      {
        "field": "DistToOwnNm",
        "kwargs": {
          "high": 40
        }
      },
      {
        "field": "BrgFromOwnRelTrkDeg"
      }
    ],
    "action_fields": [
      {
        "field": "ActiveRouteWaypointHdgDeltaDeg",
        "kwargs": {
          "low": -60,
          "high": 60
        },
        "clearance": {
          "duration": [
            60,
            600
          ],
          "lock": "duration",
          "duration_grid": {
            "type": "grid",
            "step": 60
          }
        }
      }
    ],
    "hooks": {
      "reward": "camrn = context.query(\"CAMRN\").step\nreward = -0.01  # time: a detour or a turn-back costs\nif context.query(\"STORM_1\").current.inside or context.query(\"STORM_2\").current.inside:\n    reward -= 1.0\nif context.separation.los:\n    reward -= 1.0\nif camrn.reached or camrn.satisfied:\n    reward += 10.0\nreturn reward",
      "terminated": "# Checked on every substep: passed by LNAV, or inside the reach ring\n# at any moment of the step.\ncamrn = context.query(\"CAMRN\").step\nreturn camrn.reached or camrn.satisfied",
      "truncated": "# Left the terminal area without reaching CAMRN.\nreturn not context.airspace.current.inside"
    },
    "dt": 5.0
  }
}