    "sources": [
      {
        "name": "head_on",
        "when_blocked": "defer",
        "max_aircraft": 2,
        "plan": "# This episode's aircraft, each a SpawnRequest with its time: read any data\n# (scenario setup can load a file once), draw from any distribution.\n# ctx: the episode's shapes, queryables, airspace and spawn config.\n\ncenter = ctx.airspace.center\nrot = rng.uniform(0.0, 360.0)\n# Sideways miss: exactly 0 (a true head-on) one episode in four, else within 1 NM.\noffset_nm = 0.0 if rng.random() < 0.25 else rng.uniform(-1.0, 1.0)\nout = []\nfor k, hdg in enumerate([rot % 360.0, (rot + 180.0) % 360.0]):\n    at = _point(center, hdg + 180.0, START_NM)       # start on the reciprocal: flying at the center\n    if k == 1:                                        # shift the second sideways, across its track\n        at = _point(at, hdg + 90.0, offset_nm)\n    out.append(SpawnRequest(at=at, alt_ft=ALT_FT, spd_kts=CAS_KTS, hdg_deg=hdg, actype=AC_TYPE,\n                            callsign=f\"HEAD{k + 1}\", route=_exit_route(at, hdg, ctx)))\nreturn out\n"
      }
    ]
  },
